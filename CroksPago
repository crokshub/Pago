			local h = Vector3.new(math.abs(sz.X),0,math.abs(sz.Z))*0.5
			local rt = (cf - cf.Position):VectorToWorldSpace(h)
			local rx = math.max(math.abs(rt.X),h.X,h.Z)
			local rz = math.max(math.abs(rt.Z),h.X,h.Z)
			l[#l+1] = { MinX=cf.Position.X-rx, MaxX=cf.Position.X+rx, MinZ=cf.Position.Z-rz, MaxZ=cf.Position.Z+rz }
		end
	end
	local function bad(n)
		if n == "ScrambleLocalVisuals" or n == "DrScrambleEvent" then return false end
		n = string.lower(n)
		return string.find(n,"portal",1,true) or string.find(n,"teleport",1,true) or string.find(n,"mech",1,true) or string.find(n,"arena",1,true) or string.find(n,"scramble",1,true)
	end
	for _, ch in ipairs(workspace:GetChildren()) do
		if (ch:IsA("Model") or ch:IsA("BasePart") or ch:IsA("Folder")) and bad(ch.Name) then
			if ch:IsA("Folder") then for _, i in ipairs(ch:GetChildren()) do add(i) end else add(ch) end
		end
