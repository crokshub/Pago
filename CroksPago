local function aStroke(p, base)
	local s = make("UIStroke", { Color = Color3.new(1,1,1), Thickness = base or 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
	s.Parent = p
	local g = make("UIGradient", { Color = ColorSequence.new({ColorSequenceKeypoint.new(0,CFG.Red),ColorSequenceKeypoint.new(0.5,CFG.RedGlow),ColorSequenceKeypoint.new(1,CFG.Red)}), Rotation = 0 })
	g.Parent = s
	task.spawn(function()
		local rot, t, hue, b = 0, 0, 0, base or 3
		while s.Parent do
			if NEON_MODE == "RGB" then
				hue = (hue + 0.005) % 1
				local c1 = Color3.fromHSV(hue, 1, 1)
				local c2 = Color3.fromHSV((hue + 0.15) % 1, 1, 1)
				g.Color = ColorSequence.new({ColorSequenceKeypoint.new(0,c1),ColorSequenceKeypoint.new(0.5,c2),ColorSequenceKeypoint.new(1,c1)})
			else
				local cfg = CFG.Neon[NEON_MODE] or CFG.Neon.Red
				s.Color = cfg[1]
				g.Color = ColorSequence.new({ColorSequenceKeypoint.new(0,cfg[1]),ColorSequenceKeypoint.new(0.5,cfg[2]),ColorSequenceKeypoint.new(1,cfg[1])})
			end
			rot = (rot + 6) % 360 t = t + 0.1
			s.Thickness = b + (math.sin(t)*0.5+0.5)*2.0-0.5
			g.Rotation = rot task.wait(0.03)
		end
	end)
	return s, g
end
