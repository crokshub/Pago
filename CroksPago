			else local c = CFG.Neon[NEON_MODE] or CFG.Neon.Red g.BackgroundColor3 = c[1] end
			g.BackgroundTransparency = 0.62 + (math.sin(t)*0.5+0.5)*0.18 task.wait(0.04)
