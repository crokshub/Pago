local function avoid(from, to)
	for _, d in ipairs(dangers()) do
		local x0,x1,z0,z1 = d.MinX-12, d.MaxX+12, d.MinZ-12, d.MaxZ+12
		local inside = from.X>=x0 and from.X<=x1 and from.Z>=z0 and from.Z<=z1
		if not inside then
			local t0,t1,hit = 0,1,true
			for _, ax in ipairs({{from.X,to.X-from.X,x0,x1},{from.Z,to.Z-from.Z,z0,z1}}) do
				local p, dl, lo, hi = ax[1],ax[2],ax[3],ax[4]
				if math.abs(dl)<1e-6 then if p<lo or p>hi then hit=false end
				else
					local ta,tb = (lo-p)/dl, (hi-p)/dl
					if ta>tb then ta,tb=tb,ta end
					t0,t1 = math.max(t0,ta), math.min(t1,tb)
					if t0>t1 then hit=false end
				end
			end
			if hit then
				local zL, zH = z0-2, z1+2
				local z = math.abs(from.Z-zL) <= math.abs(from.Z-zH) and zL or zH
				if z < -440 or z > -290 then z = z == zL and zH or zL end
				local x = math.abs(from.X-x0) <= math.abs(from.X-x1) and x0 or x1
				if math.abs(from.Z-z) < 3 then x = math.abs(to.X-x0) <= math.abs(to.X-x1) and x0 or x1 end
				return Vector3.new(x, to.Y, z)
			end
		end
	end
	return to
end

local function runToEgg(uid, egg)
	local lineX = lineInfo() local home = homePoint()
	local ch = lp.Character
	local h = ch and ch:FindFirstChildOfClass("Humanoid")
	if h then h.PlatformStand = false if ch:FindFirstChildWhichIsA("Tool") then pcall(function() h:UnequipTools() end) end end
	local r = root() if not r then return false end
	local stage = "field"
	if r.Position.X < lineX-2 and Vector3.new(r.Position.X-home.X,0,r.Position.Z-home.Z).Magnitude > 20 then stage = "safe" end
	local st, lc, lpl, lt = os.clock(), os.clock(), r.Position, 0
	while os.clock()-st < 120 and not state.Cancel do
		r = root() if not r then return false end
		local fe = Vector3.new(egg.X-r.Position.X,0,egg.Z-r.Position.Z)
		if stage == "field" and fe.Magnitude <= 2.5 then break end
		local tgt = egg
		if stage == "safe" then
			if Vector3.new(home.X-r.Position.X,0,home.Z-r.Position.Z).Magnitude <= 6 then stage = "field" else tgt = home end
		end
		local wp = avoid(r.Position, tgt)
		local fl = Vector3.new(wp.X-r.Position.X,0,wp.Z-r.Position.Z)
		local u = fl.Magnitude > 0.01 and fl.Unit or Vector3.zero
		local sp = math.max(walkSpeed()*1.15, 8)
		local v = u * math.min(sp, fl.Magnitude/0.05)
		pcall(function()
			r.AssemblyLinearVelocity = Vector3.new(v.X, r.AssemblyLinearVelocity.Y, v.Z)
			if h and u.Magnitude > 0 then h:Move(u, false) end
		end)
		if os.clock()-lc >= 1.5 then
			if (r.Position-lpl).Magnitude < 3 and h and fe.Magnitude > 15 then pcall(function() h.Jump = true end) end
			lpl, lc = r.Position, os.clock()
		end
		if stage == "field" and fe.Magnitude <= 9 and os.clock()-lt > 0.1 then lt = os.clock() takeEgg(uid) end
		RunService.Heartbeat:Wait()
	end
	r = root()
	if r then pcall(function() r.AssemblyLinearVelocity = Vector3.new(0,r.AssemblyLinearVelocity.Y,0) if h then h:Move(Vector3.zero,false) end end) end
	return state.Carrying or (r ~= nil and Vector3.new(egg.X-r.Position.X,0,egg.Z-r.Position.Z).Magnitude <= 6)
end

