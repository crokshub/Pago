local function parseValue(t)
	t = tostring(t or ""):lower():gsub("%s","")
	local n, s = t:match("^([%d%.]+)([kmbt]?)$")
	n = tonumber(n) if not n then return nil end
	return math.floor(n * (({k=1e3,m=1e6,b=1e9,t=1e12})[s] or 1))
end
local function passFilter(i)
	if FILTER.Mode == "Value" then return i.Value >= FILTER.MinValue end
	if FILTER.Mode == "Rarity" then return i.Rarity >= FILTER.MinRarity end
	return true
end
