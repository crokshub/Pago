	local b = workspace:FindFirstChild("World") b = b and b:FindFirstChild("Build")
	if b then for _, ch in ipairs(b:GetChildren()) do if bad(ch.Name) then for _, i in ipairs(ch:GetChildren()) do add(i) end end end end
