local function descRec(cat, rec)
	local ent = lookup(cat)
	local i = { Uid=rec.Uid, Category=tostring(cat), Name=tostring(cat), PetIcon="", EggIcon="", Rarity=0, Value=0 }
	if type(ent) == "table" then
		i.Name = tostring(ent.DisplayName or cat)
		if ent.Icon and tostring(ent.Icon) ~= "" then i.PetIcon = tostring(ent.Icon) end
		if type(ent.Egg) == "table" and ent.Egg.Icon and tostring(ent.Egg.Icon) ~= "" then i.EggIcon = tostring(ent.Egg.Icon) end
		if type(ent.Rarity) == "table" then i.Rarity = tonumber(ent.Rarity.RarityNumber or ent.Rarity.Rank) or 0 end
		local s = tonumber(rec.AssetScale) or 1
		local f = s > 5 and (s/5)^1.2 * 19.637875755794113 or s^1.85
		local m = 1
		if type(Mut) == "table" and type(Mut.EarningsFor) == "function" then
			local okM, rM = pcall(Mut.EarningsFor, type(rec.Mutations) == "table" and rec.Mutations or {})
			if okM and type(rM) == "number" then m = rM end
		end
		i.Value = (tonumber(ent.EarningRate) or 0) * f * m
	end
	return i
end
local function desc(r) return descRec(tostring(r.AssetCategory), r) end
local function fVal(v)
	if not v or v <= 0 then return "$0/s" end
	local u = {"","K","M","B","T","Qa","Qi"}
	local n, i = v, 1
	while math.abs(n) >= 1000 and i < #u do n = n/1000 i = i + 1 end
