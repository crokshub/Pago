					else TREAD.NextTry = os.clock() + 2 end
				end
			else
				if TREAD.Riding and os.clock() >= (TREAD.NextTry or 0) then
					TREAD.NextTry = os.clock() + 15
					task.spawn(function() local ok, res = askTread() if TREAD.Running then TREAD.Riding = ok and res == true end end)
				end
			end
		end
		task.wait(0.4)
	end
end
local function treadWatch()
	if TREAD.WConn then return end
	TREAD.WConn = RunService.Heartbeat:Connect(function()
		if not TREAD.Running then return end
		if TREAD.Riding and not onBelt() then TREAD.Riding = false TREAD.NextTry = 0 end
	end)
end
local function stopTreadWatch() if TREAD.WConn then TREAD.WConn:Disconnect() TREAD.WConn = nil end end
local function startTread()
	if TREAD.Running then return end
	TREAD.Running = true TREAD.Riding = false TREAD.NextTry = 0 TREAD.Tok += 1
	treadWatch() task.spawn(treadLoop)
end
local function stopTread()
	TREAD.Running = false TREAD.Tok += 1 TREAD.Riding = false TREAD.NextTry = 0
	stopTreadWatch()
	local rf = remote("RF/Treadmill/AskDoff") if rf and rf:IsA("RemoteFunction") then pcall(function() rf:InvokeServer() end) end
end

local LOOP = { On = false }
local function loopRun()
	while LOOP.On do
		if state.Busy or state.Carrying then task.wait(1)
		else
			local has = false
			for _, r in ipairs(snapshot()) do local i = desc(r) if passFilter(i) then has = true break end end
			if has then if not AUTO.Running then stopTread() startAuto() end
			else if AUTO.Running then stopAuto() task.wait(0.5) end if not TREAD.Running then startTread() end end
			task.wait(1.5)
		end
	end
end
local function startLoop()
	if LOOP.On then return end
	if FILTER.Mode == "Off" then return false end
	LOOP.On = true task.spawn(loopRun) return true
end
local function stopLoop() LOOP.On = false if AUTO.Running then stopAuto() end if TREAD.Running then stopTread() end end

