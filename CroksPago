local function instantTP(uid)
	local st = os.clock()
	local lineX, lineY = lineInfo()
	local r = root() if not r then return false end
	local lz = math.clamp(r.Position.Z, -425, -300)
	local ld = Vector3.new(lineX+14, lineY+3.35, lz)
	local hS = math.max(walkSpeed()*1.515, 40)
	local hY = r.Position.Y + 42
	local x = r.Position.X
	local rt = 0
	local rc = frozenCam()
	state.ReleaseCamera = rc
	fpsOn()
	while x - hS > ld.X and not state.Cancel do
		if not state.Carrying then
			if not regrab(uid) then break end
			local cr = root() if cr then x = math.min(x, cr.Position.X) end
			continue
		end
		local nx = x - hS
		local pb = state.PulledAt
		local hl = 0
		while hl < 0.06 do place(Vector3.new(nx, hY, lz)) hl += RunService.Heartbeat:Wait() end
		local ck = root()
		local pl = state.PulledAt > pb or (ck ~= nil and (ck.Position.X - nx > 10 or ck.AssemblyLinearVelocity.Magnitude > 150))
		if pl and state.Carrying and not state.Cancel then
			rt += 1
			if rt > 6 then break end
			local s = 0
			while s < 0.12 and not state.Cancel do place(Vector3.new(x, hY, lz)) s += RunService.Heartbeat:Wait() end
		else x = nx end
	end
	ld = Vector3.new(ld.X, groundY(ld, ld.Y), ld.Z)
	local function land()
		local cr = root()
		if cr and cr.Position.X <= ld.X+1 and cr.Position.Y > ld.Y-25 then
			pcall(function() cr.AssemblyLinearVelocity = Vector3.zero end) return
		end
		place(ld)
	end
	land()
	for at = 1, 3 do
		local s = 0
		while s < 0.08 and not state.Cancel do s += RunService.Heartbeat:Wait() end
		local lnd = root()
		if state.Carrying and lnd and (lnd.Position.X-ld.X > 12 or lnd.Position.Y < ld.Y-25) then land() else break end
	end
	if state.Carrying and not state.Cancel then
		local dl = 0
		while dl < 0.05 do dl += RunService.Heartbeat:Wait() end
		dropEgg()
		local w = 0
		while state.Carrying and w < 1 and not state.Cancel do w += RunService.Heartbeat:Wait() end
		local cr = root() if cr then pcall(function() cr.AssemblyLinearVelocity = Vector3.zero cr.AssemblyAngularVelocity = Vector3.zero end) end
		rc()
		if not grab(uid, 3) and not regrab(uid) then fpsOff() return false end
	end
	rc()
	local ok = false
	if state.Carrying then ok = true end
	fpsOff()
	return ok or state.Delivered >= st
end

local function doSteal(uid, info)
	if state.Busy then return false end
	state.Busy = true state.Cancel = false
	local ok = pcall(function()
		local e = eggPos(uid) if not e then return end
		if state.Carrying and state.Uid ~= uid then dropEgg() local w = 0 while state.Carrying and w < 1 do w += RunService.Heartbeat:Wait() end end
		fpsOn()
		if not runToEgg(uid, e) then fpsOff() return end
		if not grab(uid, 4) then fpsOff() return end
		local d = instantTP(uid)
		if d then
			STATS.Ovos += 1
			if info then registrarSteal(info) end
		end
	end)
	fpsOff()
	if state.ReleaseCamera then pcall(state.ReleaseCamera) state.ReleaseCamera = nil end
	state.Busy = false
	return ok
end

